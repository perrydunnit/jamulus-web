# Copy to `.env` and adjust. See README.md for details.

# Jamulus server to connect to, as host:port (default port 22124).
SERVER_ADDRESS=192.168.0.39:22124

# Bridge HTTP/WebSocket port.
HTTP_PORT=8080
# WebSocket path used by the browser.
WS_PATH=/ws

# Default display name advertised to the Jamulus server.
CLIENT_NAME=Web Client

# Jitter buffer size (in blocks) requested from the server.
JITTER_BLOCKS=3
# Maximum number of concurrent Jamulus channels.
MAX_SESSIONS=8
# Frame-clock busy-spin window in nanoseconds (higher = more accurate, more CPU).
SPIN_NS=500000

# Audio frame size: 128 = standard OPUS frame size (375 packets/second).
FRAME_SAMPLES=128
# Audio channels per session: 1 = mono.
CHANNELS=1
