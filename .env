# Jamulus server the bridge connects to (host:port, default port 22124).
#
# The LAN address is used for local development: most home routers do not
# support NAT loopback, so the public hostname below is not reachable from
# inside the network - use it only for deployed/remote clients.
SERVER_ADDRESS=192.168.0.39:22124
# SERVER_ADDRESS=jamulus.perry.party:22124
